# Runtime environment: development | test | production
ENV=development
PORT=41732
HOST=127.0.0.1

# Directory containing the Z-machine story files (zork1.z3, zork2.z3, zork3.z3)
STORY_DIR=./stories

# SQLite database for sessions
DATABASE_PATH=./data/zturn.sqlite

# debug | info | warn | error
LOG_LEVEL=debug

# Enables the Slack bridge at /slack. 64 hex characters; visitors' Slack
# signing secrets are encrypted with it at rest. Generate: openssl rand -hex 32
SLACK_SECRET_KEY=
