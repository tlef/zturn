{
	"name": "zturn",
	"version": "0.1.0",
	"description": "Infocom Z-machine games over HTTP, one turn per request",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"start": "node --disable-warning=ExperimentalWarning out/index.js",
		"dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/index.ts",
		"build": "tsc && node scripts/generate-api-docs.mjs",
		"docs:generate": "node scripts/generate-api-docs.mjs",
		"type-check": "tsc --noEmit",
		"lint": "eslint 'src/**/*.ts' && prettier --check 'src/**/*.ts'",
		"lint:fix": "eslint 'src/**/*.ts' --fix && prettier --write 'src/**/*.ts'",
		"test": "c8 mocha 'src/**/*.test.ts'",
		"test:single": "mocha",
		"cli": "node --disable-warning=ExperimentalWarning out/adapters/cli/index.js"
	},
	"author": "Tim Lefler",
	"license": "UNLICENSED",
	"dependencies": {
		"@koa/router": "^15.7.0",
		"ifvms": "^1.1.6",
		"koa": "^3.2.1",
		"koa-body": "^8.0.1",
		"swagger-jsdoc": "^6.3.0",
		"swagger-ui-dist": "^5.33.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/chai": "^5.2.3",
		"@types/koa": "^3.0.3",
		"@types/koa__router": "^12.0.5",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.20.3",
		"@types/supertest": "^7.2.1",
		"@types/swagger-jsdoc": "^6.0.4",
		"c8": "^12.0.0",
		"chai": "^6.2.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"mocha": "12.0.0",
		"prettier": "^3.9.7",
		"supertest": "^7.2.2",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0"
	}
}
